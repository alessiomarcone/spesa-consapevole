{
  "schemaVersion": 1,
  "id": "optimizer-demo-household",
  "location": {
    "country": "IT",
    "deliveryArea": "sample-area"
  },
  "cycleWeeks": 4,
  "budget": {
    "cashPerWeek": 10,
    "cashPerCycle": 40,
    "rolling": true
  },
  "vouchers": {
    "provider": "sample-vouchers",
    "values": [7, 7, 7, 7]
  },
  "health": {
    "enabled": true,
    "provider": "fixture",
    "thresholds": {
      "core": 71,
      "flex": 50
    },
    "unknownCore": "block"
  },
  "discountPolicy": {
    "minimumComparableShare": 0.7,
    "minimumSavingsEuro": 5,
    "minimumSavingsRate": 0.05,
    "maxQuoteAgeHours": 24,
    "unknownMarkup": "block"
  },
  "excludedCategories": ["fresh-fruit", "fresh-vegetables"]
}
