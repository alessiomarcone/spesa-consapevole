{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alessiomarcone/spesa-consapevole/main/schemas/v1/catalog.schema.json",
  "title": "Spesa Consapevole comparable retailer catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceType", "currency", "capturedAt", "expiresAt", "stores"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceType": { "enum": ["fixture", "live"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "stores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/store" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 80 },
    "money": { "type": "number", "minimum": 0, "multipleOf": 0.001 },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "priceBasis", "deliveryFee", "serviceFee", "minimumFoodSubtotal", "acceptsVouchers", "maxVouchers", "offers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "priceBasis": { "enum": ["live_online", "same_as_store_verified"] },
        "deliveryFee": { "$ref": "#/$defs/money" },
        "serviceFee": { "$ref": "#/$defs/money" },
        "minimumFoodSubtotal": { "$ref": "#/$defs/money" },
        "acceptsVouchers": { "type": "boolean" },
        "maxVouchers": { "type": "integer", "minimum": 0, "maximum": 20 },
        "offers": {
          "type": "array",
          "items": { "$ref": "#/$defs/offer" }
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needId", "productId", "name", "unit", "unitPrice", "available", "voucherEligible", "scoreSource"],
      "properties": {
        "needId": { "$ref": "#/$defs/id" },
        "productId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 },
        "unitPrice": { "$ref": "#/$defs/money" },
        "available": { "type": "boolean" },
        "stockUnits": { "type": "integer", "minimum": 0 },
        "voucherEligible": { "type": "boolean" },
        "healthScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "scoreSource": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
